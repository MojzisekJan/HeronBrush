# Python caches from asset generators.
__pycache__/
*.py[cod]

# Motion lab engine cache and generated verification measurements.
/demos/motion_lab/godot/.godot/
/demos/motion_lab/godot/verification.json
/demos/motion_lab/godot/**/*.uid
/crates/heron-brush-web/dist

# LibreQuake wads and compiler output for the Quake demo.
/demos/quake_libre/wads/
/demos/quake_libre/build/

