attribute highp vec4 position;
attribute mediump vec3 normal;
attribute mediump vec2 texcoord0;
uniform highp mat4 mtx_world;
uniform highp mat4 mtx_worldview;
uniform highp mat4 mtx_proj;
varying highp vec3 var_position;
varying mediump vec3 var_normal;
varying mediump vec2 var_texcoord0;
void main() {
    mat3 m = mat3(mtx_world);
    mat3 cofactors = mat3(cross(m[1],m[2]),cross(m[2],m[0]),cross(m[0],m[1]));
    var_normal = normalize(cofactors * normal) * sign(dot(m[0],cross(m[1],m[2])));
    var_position = (mtx_world * vec4(position.xyz,1.0)).xyz;
    var_texcoord0 = texcoord0;
    gl_Position = mtx_proj * mtx_worldview * vec4(position.xyz,1.0);
}
